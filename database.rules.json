{
  "rules": {
    "stations": {
      ".read": true,
      ".write": false
    },
    "slot_extensions": {
      ".read": true,
      "$slot": {
        ".write": "$slot.matches(/^\\d+-\\d+$/) && (!newData.exists() || (newData.hasChildren(['by', 'at', 'extra_minutes', 'until_ms']) && newData.child('extra_minutes').isNumber() && newData.child('extra_minutes').val() >= 15 && newData.child('extra_minutes').val() <= 480 && newData.child('until_ms').isNumber() && newData.child('until_ms').val() >= now + 900000 && newData.child('until_ms').val() <= now + 86400000))",
        "by": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "at": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "extra_minutes": {
          ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 480"
        },
        "until_ms": {
          ".validate": "newData.isNumber() && newData.val() >= now + 900000 && newData.val() <= now + 86400000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "slot_resets": {
      ".read": true,
      "$slot": {
        ".write": "$slot.matches(/^\\d+-\\d+$/) && (!newData.exists() || (newData.hasChildren(['at', 'at_ms']) && newData.child('at_ms').isNumber() && newData.child('at_ms').val() >= now - 86400000 && newData.child('at_ms').val() <= now + 600000))",
        "at": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "at_ms": {
          ".validate": "newData.isNumber() && newData.val() >= now - 86400000 && newData.val() <= now + 600000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
