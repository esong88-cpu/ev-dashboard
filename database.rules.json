{
  "rules": {
    "stations": {
      ".read": true,
      ".write": false
    },
    "slot_extensions": {
      ".read": true,
      "$slot": {
        ".write": "newData.val() == null || newData.hasChildren(['by', 'at', 'extra_minutes', 'until_ms'])",
        "by": {
          ".validate": "newData.isString()"
        },
        "at": {
          ".validate": "newData.isString()"
        },
        "extra_minutes": {
          ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 480"
        },
        "until_ms": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "slot_resets": {
      ".read": true,
      "$slot": {
        ".write": "newData.val() == null || newData.hasChildren(['at', 'at_ms'])",
        "at": {
          ".validate": "newData.isString()"
        },
        "at_ms": {
          ".validate": "newData.isNumber() && newData.val() >= now - 86400000 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
