{
  "rules": {
    "stations": {
      ".read": true,
      ".write": false
    },
    "slot_extensions": {
      ".read": true,
      "$slot": {
        ".write": "!newData.exists() || ($slot.matches(/^[0-9]+-[0-9]+$/) && newData.hasChildren(['by', 'at', 'extra_minutes', 'until_ms']))",
        "by": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "at": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "extra_minutes": {
          ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 480"
        },
        "until_ms": {
          ".validate": "newData.isNumber() && newData.val() >= now && newData.val() <= now + 28800000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "slot_resets": {
      ".read": true,
      "$slot": {
        ".write": "!newData.exists() || ($slot.matches(/^[0-9]+-[0-9]+$/) && newData.hasChildren(['at', 'at_ms']))",
        "at": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "at_ms": {
          ".validate": "newData.isNumber() && newData.val() >= now - 900000 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
